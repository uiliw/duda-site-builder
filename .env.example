# Copie para ~/.config/duda/credentials.env (uma vez por máquina) e rode: chmod 600 ~/.config/duda/credentials.env
# Valores: peça ao dev master por canal privado (gerenciador de senhas). NUNCA commite este arquivo preenchido.

# Partner API da Duda (Basic auth)
DUDA_API_USER=
DUDA_API_PASS=

# Token do MCP da Duda (header Authorization)
DUDA_TOKEN=
